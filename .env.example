# Shape of the repo-root .env that `npm run bootstrap` writes (gitignored).
# Read by the seed/verify scripts (scripts/lib/load-env.mjs) and passed to
# docker compose for the app containers (scripts/compose.mjs). Ids/secrets
# are created per stack by bootstrap — don't copy them between machines.
MEDPLUM_BASE_URL=http://localhost:8103
MEDPLUM_PROJECT_ID=
MEDPLUM_SERVICE_CLIENT_ID=
MEDPLUM_SERVICE_CLIENT_SECRET=
HINS_DEMO_PATIENT_ID=
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_SERVICE_CLIENT_ID=hins-rbac-service
KEYCLOAK_SERVICE_CLIENT_SECRET=
DATABASE_URL=postgres://hins:hins@localhost:5433/hins
CONSENT_SERVICE_URL=http://localhost:4001
AUDIT_SERVICE_URL=http://localhost:4005
DEID_SERVICE_URL=http://localhost:4003
VITE_MEDPLUM_BASE_URL=http://localhost:8103/
VITE_MEDPLUM_CLIENT_ID=
VITE_CONSENT_SERVICE_URL=http://localhost:4001
VITE_AUDIT_SERVICE_URL=http://localhost:4005
VITE_ASR_URL=http://localhost:8000
