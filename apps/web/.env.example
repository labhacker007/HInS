# `npm run bootstrap` writes apps/web/.env.local with this machine's values
# (it creates the "HInS Web (local dev)" Medplum ClientApplication and fills
# in its id) — you normally never edit this by hand.
VITE_MEDPLUM_BASE_URL=http://localhost:8103/
VITE_MEDPLUM_CLIENT_ID=
VITE_CONSENT_SERVICE_URL=http://localhost:4001
VITE_AUDIT_SERVICE_URL=http://localhost:4005
# Self-hosted speech-to-text (speaches / Whisper) — infra/docker-compose.asr.yml
VITE_ASR_URL=http://localhost:8000
VITE_ASR_MODEL=Systran/faster-whisper-small.en
