{
  "name": "hins-platform",
  "private": true,
  "description": "HInS — modular, API-first, AI-native hospital platform. See docs/PLATFORM_BLUEPRINT.md.",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "build": "npm run build -w packages/shared && npm run build --workspaces --if-present",
    "dev:consent-service": "npm run dev -w services/consent-service",
    "dev:terminology-service": "npm run dev -w services/terminology-service",
    "seed:demo": "node scripts/seed/seed-demo-data.mjs"
  }
}
