{
  "name": "hins-platform",
  "private": true,
  "description": "HInS — modular, API-first, AI-native hospital platform. See docs/PLATFORM_BLUEPRINT.md.",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "up": "node scripts/up.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "build": "npm run build -w packages/shared && npm run build --workspaces --if-present",
    "dev:consent-service": "npm run dev -w services/consent-service",
    "dev:terminology-service": "npm run dev -w services/terminology-service",
    "dev:deid-service": "npm run dev -w services/deid-service",
    "dev:audit-service": "npm run dev -w services/audit-service",
    "seed:demo": "node scripts/seed/seed-demo-data.mjs",
    "app:up": "node scripts/compose.mjs app up -d --build",
    "app:down": "node scripts/compose.mjs app down",
    "app:logs": "node scripts/compose.mjs app logs -f",
    "seed:showcase": "esbuild scripts/seed/showcase/seed-showcase.ts --bundle --platform=node --format=esm --target=node22 --log-level=warning --outfile=scripts/seed/showcase/.build/seed-showcase.mjs && node scripts/seed/showcase/.build/seed-showcase.mjs",
    "asr:up": "docker compose -f infra/docker-compose.asr.yml up -d",
    "db:migrate": "node scripts/bootstrap.mjs --migrate-only"
  }
}
