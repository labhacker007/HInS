#!/usr/bin/env bash
# Git credential helper for github.com that issues short-lived GitHub App
# user tokens (8h) via the OAuth device flow.
#
# Nothing is written to disk: the token is handed to git, which keeps it in
# the in-memory `credential-cache` daemon until it expires. The refresh token
# is discarded on purpose, so once the token expires the developer simply
# re-authorizes in the browser.
#
# Only the "get" operation is implemented; "store"/"erase" are handled by
# credential-cache, which sits before this helper in the chain.
set -euo pipefail

[[ "${1:-}" == "get" ]] || exit 0

protocol="" host=""
while IFS='=' read -r key value; do
  [[ -z "$key" ]] && break
  case "$key" in
    protocol) protocol="$value" ;;
    host) host="$value" ;;
  esac
done
[[ "$protocol" == "https" && "$host" == "github.com" ]] || exit 0

# Messages go to the terminal; stdout is reserved for the credential protocol.
{ exec 3>/dev/tty; } 2>/dev/null || exec 3>&2
say() { printf '%s\n' "$*" >&3; }

client_id="${HINS_GITHUB_APP_CLIENT_ID:-$(git config --get hins.githubAppClientId || true)}"
if [[ -z "$client_id" ]]; then
  say "hins-auth: no GitHub App client ID configured (run scripts/dev-auth/setup.sh)."
  exit 0
fi

post() {
  curl -fsS -X POST -H 'Accept: application/json' "$@"
}

device=$(post -d "client_id=$client_id" https://github.com/login/device/code)
device_code=$(jq -r '.device_code' <<<"$device")
user_code=$(jq -r '.user_code' <<<"$device")
verify_url=$(jq -r '.verification_uri' <<<"$device")
interval=$(jq -r '.interval // 5' <<<"$device")
expires_in=$(jq -r '.expires_in // 900' <<<"$device")

printf '%s' "$user_code" | pbcopy 2>/dev/null || true
say ""
say "hins-auth: authorize this machine for GitHub (token valid ~8h)"
say "  1. Open:  $verify_url"
say "  2. Enter: $user_code   (copied to clipboard)"
say ""
open "$verify_url" 2>/dev/null || true

deadline=$((SECONDS + expires_in))
while (( SECONDS < deadline )); do
  sleep "$interval"
  resp=$(post -d "client_id=$client_id" -d "device_code=$device_code" \
    -d "grant_type=urn:ietf:params:oauth:grant-type:device_code" \
    https://github.com/login/oauth/access_token)

  token=$(jq -r '.access_token // empty' <<<"$resp")
  if [[ -n "$token" ]]; then
    ttl=$(jq -r '.expires_in // 28800' <<<"$resp")
    # Expire a few minutes early so git never presents a just-expired token.
    expiry=$(( $(date +%s) + ttl - 300 ))
    say "hins-auth: authorized; token expires $(date -r "$expiry" '+%Y-%m-%d %H:%M')."
    printf 'username=x-access-token\npassword=%s\npassword_expiry_utc=%s\n' "$token" "$expiry"
    exit 0
  fi

  case "$(jq -r '.error // empty' <<<"$resp")" in
    authorization_pending) ;;
    slow_down) interval=$(jq -r --argjson i "$interval" '.interval // ($i + 5)' <<<"$resp") ;;
    *) say "hins-auth: authorization failed: $(jq -r '.error_description // .error' <<<"$resp")"; exit 1 ;;
  esac
done

say "hins-auth: device code expired before authorization."
exit 1
